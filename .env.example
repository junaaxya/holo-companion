# Copy this file to .env for machine-local secrets. Do not commit .env.
# The app does not load .env automatically; export this variable in your shell
# before running llm-test against a real OpenAI-compatible provider.
LLM_API_KEY=

# ElevenLabs Phase 5 TTS smoke is a paid manual check. The app does not load
# .env automatically; source/export these in your shell before running it:
# set -a; . ./.env; set +a
# Example:
# uv run holo-companion tts-smoke --emotion playful --intensity 0.6 --text "Ih... ternyata kamu belum tidur juga." --output recordings/tts-eval/holo-elevenlabs-playful.wav
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=
